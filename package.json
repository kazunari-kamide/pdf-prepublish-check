{
  "name": "omamori-pdf",
  "version": "0.0.0",
  "private": true,
  "description": "PDF を公開・提出する前に、見た目では分からない情報を見つけて片付ける検査器（ブラウザの中だけで動く）",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "omamori-pdf": "cli/omamori.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "eval": "node eval/all.ts",
    "eval:p6": "node eval/p6.ts",
    "eval:p1": "node eval/p1.ts",
    "eval:p9": "node eval/p9.ts",
    "eval:p5": "node eval/p5.ts",
    "eval:p7": "node eval/p7.ts",
    "eval:pii": "node eval/pii.ts",
    "eval:pii-count": "node eval/pii-count.ts",
    "eval:sanitize": "node eval/sanitize.ts",
    "eval:new": "node eval/new-rules.ts",
    "check:sanitized": "node sanitize/check/cli.ts",
    "check:browser": "node scripts/check-browser.mjs",
    "check:live": "node scripts/check-live.mjs",
    "cli": "node cli/omamori.ts",
    "eval:redact": "vitest run tests/redact-eval.test.ts --silent=false"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@types/node": "24.19.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
